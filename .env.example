# Copy to .env.local and fill in. Leave the project id empty to run the site on src/data/defaults.ts.

# From sanity.io/manage → your project (free plan is enough).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# sanity.io/manage → API → Tokens → Add token, permission "Viewer".
# Lets the dashboard's "Edit website" preview show drafts. Server-only: never prefix it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Only for scripts/seed-sanity.mts, permission "Editor". Delete the token in Sanity after seeding.
SANITY_WRITE_TOKEN=
